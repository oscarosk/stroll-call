# Copy this file to .env and fill in what you have. Everything except Ollama is optional.

OLLAMA_URL=http://localhost:11434
# 8 GB RAM: gemma3:4b works; use gemma3:1b if it is too slow
OLLAMA_MODEL=gemma3:4b

# local = offline Windows voice, elevenlabs = natural multilingual voice, none = text only
TTS_BACKEND=local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Leave empty to store walks in data/walks.json
MONGODB_URI=
MONGODB_DB=stroll_call

# Leave empty to disable tracing
SENTRY_DSN=
